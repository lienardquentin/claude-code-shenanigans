  },
  "dependencies": {
    "@xyflow/react": "12.3.2",
    "elkjs": "0.9.3",
    "framer-motion": "11.11.9",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.48.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-plugin-singlefile": "2.0.2"
  }
}
