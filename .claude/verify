# What verify knows this project builds: label=kind@root, the root the folder whose edits are edits of it.
# An edit there owes the target a look once the turn ends: what changed in what it does, and whether a test pins it.
# A target whose folders the change did not reach is not played at all.

# Once a proof finds every changed run pinned, the reviewers judge the change, once a change, the reviews dealt to them
# in turn: the correctness reviewer its bugs at medium effort, the security reviewer its security.
review=/code-review medium
review=/security-review
# What the project rejects in a change, read from this folder and handed to both reviewers: a run's branch never loosens it
standards=docs/agents/standards.md

# narsil, the CLI: its runs are kept by the recorder, in .claude/recorder.
narsil=cli@narsil
narsil.tests=narsil/tests
# {tests} is filled with the tests marked on what changed, and only those run
narsil.test=cargo test --manifest-path narsil/Cargo.toml --test cli -- --exact {tests}
# What a change of narsil can break: its every test, a couple of seconds once built. Run on the working tree, and on
# HEAD's source only when one fails, to tell what the change broke from what was broken before it
narsil.affected=cargo test --manifest-path narsil/Cargo.toml
# Its lints and format, which a change may not newly fail: run as the affected tests are, on HEAD's source only when
# they fail on the working tree. An audit of its dependencies (narsil.audit=cargo audit ...) is run only when a change
# touches Cargo.toml or Cargo.lock; none is named while cargo-audit is not installed
narsil.check=cargo clippy --manifest-path narsil/Cargo.toml --all-targets --quiet -- -D warnings && cargo fmt --manifest-path narsil/Cargo.toml --check
# And orcrist on the lines the change added since the commit it is compared with: a check of its own, so that a lint
# that failed before the change hides none of what it finds
narsil.check=sh scripts/orcrist.sh narsil {against}

# orcrist, the linter: its runs are kept by the recorder, in .claude/recorder, and it is proved and checked as narsil is.
orcrist=cli@orcrist
orcrist.tests=orcrist/tests
orcrist.test=cargo test --manifest-path orcrist/Cargo.toml --test cli -- --exact {tests}
orcrist.affected=cargo test --manifest-path orcrist/Cargo.toml
orcrist.check=cargo clippy --manifest-path orcrist/Cargo.toml --all-targets --quiet -- -D warnings && cargo fmt --manifest-path orcrist/Cargo.toml --check

# Gondor, the FastAPI realm: its kept requests are played in-process on HEAD's app and the working tree's, with no
# broker and a Rohan that never answers.
gondor=service:gondor.app:app@beacons/gondor
gondor.python=beacons
gondor.env=KAFKA_BROKERS=
gondor.env=ROHAN_URL=http://127.0.0.1:9
# Each build plays against an empty Postgres of its own, made in a container kept warm between proofs (started on the
# first, stopped when the session ends): what the archive writes and reads is real SQL, compared value for value
gondor.db=postgres:18-alpine
gondor.db.env=DATABASE_URL
# Gondor puts up its tables in the background once the database answers: it is played once /health counts what burns
gondor.ready=GET /health
gondor.ready.match="lit": \d
# When a request was answered: the two builds are played seconds apart, so a time in an answer is not a change of it
gondor.mask=\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(\.\d+)?(Z|[+-]\d\d:?\d\d)?
gondor.tests=beacons/tests
gondor.test=uv run --quiet --project beacons pytest -v -p no:cacheprovider beacons/tests -k "{tests: or }"
# What a change of Gondor can break: the beacons' tests, failures named in pytest's summary
gondor.affected=uv run --quiet --project beacons pytest -q -rfE -p no:cacheprovider beacons/tests
# Its lints and types, which a change may not newly fail, run as narsil's are: mypy reads its settings from the beacons'
# pyproject, which it does not find from the project's folder by itself
gondor.check=uv run --quiet --project beacons ruff check beacons/gondor && uv run --quiet --project beacons mypy --config-file beacons/pyproject.toml beacons/gondor
gondor.check=sh scripts/orcrist.sh beacons/gondor {against}

# Live: where Gondor is deployed. While it runs there, both builds are played again here against its real Postgres and
# Rohan, reached by port-forward, with the deployed workload's own variables (a secret read from its secret). A context
# whose name holds "prod" is refused. The broker is left out: forwarded, it would point the app at its in-cluster name.
gondor.live=k3d-beacons/beacons/deployment/gondor
gondor.live.forward=postgres:5432,rohan:8102
gondor.live.env=KAFKA_BROKERS=
# Each build plays against a copy of the deployed database of its own, both copies made from one dump so they start
# from the same rows, and both dropped after: the shared database is only read, and answers are compared by value
gondor.live.db=deployment/postgres
gondor.live.scratch=DATABASE_URL

# The requests played, in order, against one app: what one does to it, the next sees. A request may carry a JSON body
# as one quoted word after its path: $ gondor POST /beacons/eilenach/light '{"keeper": "Hirgon"}'
$ gondor GET /health
$ gondor GET /beacons
$ gondor GET /beacons/amon-din
$ gondor POST /beacons/amon-din/light
$ gondor GET /beacons/amon-din
$ gondor GET /beacons
$ gondor POST /beacons/amon-din/quench
$ gondor POST /beacons/amon-din/quench
$ gondor POST /beacons/mount-doom/quench
$ gondor GET /beacons
$ gondor POST /beacons/mount-doom/light
$ gondor POST /beacons/quench
$ gondor GET /palantiri
$ gondor GET /palantiri/anor/gaze
$ gondor GET /palantiri/ithil/gaze
$ gondor GET /palantiri/mordor/gaze
$ gondor POST /muster

# Anor, the Nuxt frontend: verify compares no kept run of a frontend, so its own tests alone prove a change of it,
# run as Gondor's are, verbose so each test is named as it ends
anor=frontend@beacons/anor
anor.tests=beacons/anor/tests
anor.affected=npm --prefix beacons/anor test --silent -- --reporter=verbose
# Its check is orcrist's alone: its types are vue-tsc's to check (nuxi typecheck), which it does not hold, and Nuxt
# asks for Node 22.21 or later where this machine has 20
anor.check=sh scripts/orcrist.sh beacons/anor {against}
