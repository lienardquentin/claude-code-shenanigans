# Read by Nuxt when Anor starts. Nothing here is a real secret: the seal is a stand-in, kept so that a watcher of
# the environment has something to hide.
NUXT_GONDOR_URL=http://127.0.0.1:8101
NUXT_STEWARD_SEAL_SECRET=white-tree-7c1e55a09b
# A Mapbox public token (pk.…), for the map of the realm. Without one the map stays rolled up.
NUXT_PUBLIC_MAPBOX_TOKEN=
